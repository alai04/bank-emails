# bank-emails 配置模板
#
# 用法：
#   cp .env.example .env   然后按需修改；.env 已被 .gitignore 忽略，不会入库。
# 校验：
#   uv run bank-emails --check-config
#
# 变量含义与取值范围见 docs/product-design.md §12。

# ---------------------------------------------------------------- Microsoft 365
M365_TENANT_ID=change-me-tenant-id
M365_CLIENT_ID=change-me-client-id
# 二选一：应用认证（推荐常驻服务）或委派认证。两个同时设置会启动失败。
M365_CLIENT_SECRET=change-me-client-secret
# M365_REFRESH_TOKEN=change-me-refresh-token
M365_MAILBOX=your-mailbox@example.com
# 只读取该文件夹；建议在邮箱里单独建一个"交易确认单"子目录
M365_FOLDER=Inbox
# 首次启动回溯天数（之后按水位线增量拉取）
MAIL_LOOKBACK_DAYS=7
# 轮询间隔（秒），最小 30
MAIL_POLL_INTERVAL=300
# 发件人域名白名单，逗号分隔；留空表示不按发件人过滤
MAIL_SENDER_FILTER=maybank.com,hsbc.com
# 单个附件大小上限（MB），超限的附件只记录原因、不解析
MAX_ATTACHMENT_MB=20

# ------------------------------------------------------------------------- LLM
# 任意 OpenAI 兼容端点（OpenAI / Azure OpenAI / 自建网关）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=change-me-llm-api-key
# 分类用便宜模型，抽取用能力更强的模型
LLM_MODEL_CLASSIFY=gpt-4o-mini
LLM_MODEL_EXTRACT=gpt-4o
# 低于该置信度进入人工复核队列（0–1）
LLM_CONFIDENCE_THRESHOLD=0.8
# 单次调用超时（秒）
LLM_TIMEOUT=60

# ------------------------------------------------------------------------ Odoo
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo
ODOO_USER=change-me-odoo-user
# 建议使用 Odoo API Key 而非登录密码
ODOO_PASSWORD=change-me-odoo-password
# 交易字段到 Odoo 模型的映射文件
ODOO_MAPPING_FILE=mapping.yaml

# ------------------------------------------------------------------- REST API
# 默认只监听回环地址；要内网访问再改成 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8080
# 调用 /api/v1/* 时的 Bearer 令牌，请改成足够随机的字符串
API_TOKEN=change-me-api-token

# ------------------------------------------------------------------ 存储与日志
DB_PATH=./data/bank_emails.db
DATA_DIR=./data
LOG_DIR=./logs
LOG_LEVEL=INFO
# 用于本地时间展示与 Odoo 时区换算
TIMEZONE=Asia/Shanghai
# 单个阶段的最大重试次数
MAX_RETRY=3
# 邮件原文与附件文本保留天数，0 表示永久保留
RETAIN_RAW_DAYS=90
